<wpf:Window xmlns:wpf="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
            x:Class="StoryGameApp.MainWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Title="CS110 Story Game" Width="960" Height="760" MinWidth="600" MinHeight="560"
            Background="#10251F" Foreground="#F1F5EB">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="FIELD STORY / CS110" Foreground="#EED19B" FontSize="16"/>
      <TextBlock x:Name="SlideCounter" FontSize="16" Margin="0,8"/>
      <Image x:Name="StoryImage" Height="260" Stretch="Uniform"
             AutomationProperties.Name="Current story illustration"/>
      <TextBlock x:Name="StoryTextBlock" FontSize="22" TextWrapping="Wrap" Margin="0,14"/>
      <TextBlock x:Name="ImageDescription" TextWrapping="Wrap" FontSize="14"/>
      <WrapPanel Margin="0,14">
        <Button x:Name="BackButton" Content="_Back" Click="BackButton_Click" Padding="18,10" Margin="0,0,8,8"/>
        <Button x:Name="NextButton" Content="_Next" Click="NextButton_Click" Padding="18,10" Margin="0,0,8,8"/>
        <Button Content="_Restart" Click="RestartButton_Click" Padding="18,10" Margin="0,0,8,8"/>
      </WrapPanel>
      <UserControl x:Class="ImageCapture.CaptureControls"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   MinWidth="700" MinHeight="450">

        <Grid Background="#F5F7FA">

          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- ================================================= -->
          <!-- HEADER / WORKFLOW -->
          <!-- ================================================= -->

          <Border Grid.Row="0"
                  Background="#173F67"
                  Padding="15">

            <StackPanel>

              <TextBlock Text="IMAGE CAPTURE"
                         Foreground="White"
                         FontSize="24"
                         FontWeight="Bold"/>

              <TextBlock Text="Draw Capture → Image → Preview → Save or Cancel → Clear → Repeat"
                         Foreground="#DCEAF7"
                         FontSize="14"
                         Margin="0,5,0,0"/>

            </StackPanel>

          </Border>


          <!-- ================================================= -->
          <!-- MAIN CONTENT -->
          <!-- ================================================= -->

          <Grid Grid.Row="1"
                Margin="15">

            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>


            <!-- ============================================= -->
            <!-- DRAW CAPTURE -->
            <!-- ============================================= -->

            <GroupBox Grid.Column="0"
                      Header="1. Draw Capture"
                      Margin="5">

              <Grid>

                <Canvas x:Name="CaptureCanvas"
                        Background="#E7EDF3"
                        MouseLeftButtonDown="CaptureCanvas_MouseLeftButtonDown"
                        MouseMove="CaptureCanvas_MouseMove"
                        MouseLeftButtonUp="CaptureCanvas_MouseLeftButtonUp">

                  <!-- Captured image -->

                  <Image x:Name="CaptureImage"
                         Stretch="Uniform"
                         IsHitTestVisible="False"/>

                  <!-- Selection rectangle -->

                  <Rectangle x:Name="SelectionRectangle"
                              Stroke="#E53935"
                              StrokeThickness="2"
                              Fill="#33FF0000"
                              Visibility="Collapsed"/>

                </Canvas>

              </Grid>

            </GroupBox>


            <!-- ============================================= -->
            <!-- PREVIEW -->
            <!-- ============================================= -->

            <GroupBox Grid.Column="1"
                      Header="2. Preview"
                      Margin="5">

              <Grid Background="White">

                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       Margin="10"/>

                <TextBlock x:Name="PreviewPlaceholder"
                           Text="Your captured image will appear here."
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"/>

              </Grid>

            </GroupBox>


            <!-- ============================================= -->
            <!-- CONTROLS -->
            <!-- ============================================= -->

            <GroupBox Grid.Column="2"
                      Header="Controls"
                      Margin="5">

              <StackPanel Margin="10">

                <!-- File name -->

                <TextBlock Text="File Name"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="FileNameBox"
                         Text="capture_001"
                         Margin="0,0,0,15"/>


                <!-- Format -->

                <TextBlock Text="Format"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="FormatComboBox"
                          SelectedIndex="0"
                          Margin="0,0,0,15">

                  <ComboBoxItem Content="PNG"/>
                  <ComboBoxItem Content="JPG"/>
                  <ComboBoxItem Content="BMP"/>

                </ComboBox>


                <!-- Save -->

                <Button x:Name="SaveButton"
                        Content="Save"
                        Height="40"
                        Margin="0,5"
                        Background="#2E7D32"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="SaveButton_Click"/>


                <!-- Cancel -->

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Height="40"
                        Margin="0,5"
                        Background="#607D8B"
                        Foreground="White"
                        Click="CancelButton_Click"/>


                <!-- Clear -->

                <Button x:Name="ClearButton"
                        Content="Clear"
                        Height="40"
                        Margin="0,5"
                        Background="#C62828"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="ClearButton_Click"/>

              </StackPanel>

            </GroupBox>

          </Grid>


          <!-- ================================================= -->
          <!-- STATUS BAR -->
          <!-- ================================================= -->

          <Border Grid.Row="2"
                  Background="#E0E6EC"
                  Padding="10">

            <DockPanel>

              <Ellipse Width="12"
                       Height="12"
                       Fill="#2E7D32"
                       Margin="0,0,8,0"/>

              <TextBlock x:Name="StatusText"
                         Text="Ready"
                         VerticalAlignment="Center"/>

              <TextBlock DockPanel.Dock="Right"
                         Text="Capture • Preview • Save • Repeat"
                         Foreground="#555555"/>

            </DockPanel>

          </Border>

        </Grid>

      </UserControl>
      <StackPanel x:Name="CapturePanel"/>
      <TextBlock x:Name="StatusText" Text="Ready. Use Next to read the story." TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" Margin="0,10"/>
    </StackPanel>
  </ScrollViewer>
</wpf:Window>
